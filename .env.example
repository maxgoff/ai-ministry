# AI Ministry Environment Configuration
# Copy this file to .env and fill in your API keys

# =============================================================================
# LLM API Configuration (REQUIRED)
# =============================================================================
# LLM_API_KEY is REQUIRED - the application will fail to start without it.
# This should be the API key for your LLM provider or LiteLLM proxy.
#
# Default URL: LiteLLM local proxy (http://localhost:4000/chat/completions)
# For OpenRouter: https://openrouter.ai/api/v1/chat/completions
LLM_API_URL=http://localhost:4000/chat/completions
LLM_API_KEY=your-api-key-here  # REQUIRED: Set this to your actual API key

# =============================================================================
# Provider API Keys (required for LiteLLM)
# =============================================================================
# Get your keys from:
#   OpenAI:    https://platform.openai.com/api-keys
#   Anthropic: https://console.anthropic.com/settings/keys
#   Google:    https://aistudio.google.com/app/apikey
#   xAI:       https://console.x.ai/

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...
# XAI_API_KEY=xai-...  # Uncomment when you have a key

# =============================================================================
# Moonshot/Kimi Configuration
# =============================================================================
# Get your key from: https://platform.moonshot.ai/
MOONSHOT_API_KEY=sk-...

# =============================================================================
# Ollama Configuration (for local/LAN models - optional)
# =============================================================================
# Point to your Ollama server (default: http://localhost:11434)
# OLLAMA_API_BASE=http://localhost:11434

# =============================================================================
# Legacy OpenRouter Support (optional, if not using LiteLLM)
# =============================================================================
# OPENROUTER_API_KEY=sk-or-v1-...
